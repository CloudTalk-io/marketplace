// E5 — Multilingual table-reservation agent with ElevenLabs tuning.
// Provider: ElevenLabs (set via `provider` — multilingual must be ElevenLabs; Deepgram cannot serve it).
// LLM: Haiku 4.5 (complex: secondary languages).
// Demonstrates: secondaryLanguages (multilingual), elevenLabsSettings (turn-taking tuned for data
// collection), asrKeywords, and `turnModel: "turn_v3"` — the newer turn-detection model, safe to select
// here because this API pins the ASR provider turn_v3 needs (schema §10). E8 carries the rest of the
// elevenLabsSettings surface; between the two files every sub-field is shown.
// Its three hangup scenarios carry an EMPTY `reply` by design: the closings live in the goalPrompt so the
// agent adapts the goodbye to the conversation, and each scenario only ends the call once the goodbye has
// been said (behavioral §4.3). A multilingual agent may also write a literal English `reply` — the compiled
// prompt renders it in the caller's language (§4.2).
//
// This agent takes the reservation request and hands it to the restaurant to confirm — fully self-contained.
// To let the agent book into a calendar directly, connect a Google/Outlook calendar in the UI and enable
// the appointmentBooking skill with its integrationId + calendarId (referenced-resources.md).
{
  "agentName": "Lumen Bistro: Reservations",
  "direction": "inbound",
  "defaultOutboundNumberId": 1,    // Automatic — required even for an inbound agent, which never calls out
  "failoverOutboundNumberId": 202, // replace with a real owned number id (cloudtalk_list_numbers or the
                                   // dashboard) — Automatic requires a real failover in BOTH directions
  "language": "en",
  "secondaryLanguages": ["de", "fr"], // needs ElevenLabs; runtime adds automatic language detection
  "provider": "elevenlabs",        // multilingual needs ElevenLabs — a save keeps a stored Deepgram provider otherwise
  "llm": "anthropic - claude-haiku-4-5",
  "maxCallDuration": 20,
  "temperature": 0.5,
  "voice": "cgSgspJ2msm6clMCkdW9", // Jessica — Female, American English; multilingual (speaks de/fr here too)
  "optimizeStreamingLatency": 2,
  "stability": 0.6,                // raised above the 0.3 baseline: agent also speaks non-English
  "similarity": 0.7,
  "startSpeakingFirst": true,
  "elevenLabsSettings": {
    "speculativeTurn": true,       // cut perceived latency; costs some extra LLM tokens
    "turnEagerness": "patient",    // data collection: give callers time to finish names/dates
    "turnModel": "turn_v3",        // safe through this API — ASR is pinned to Scribe Realtime
    "vad": true,                   // filter background voices (callers often call from home)
    "asrKeywords": ["Lumen Bistro", "Garden Room"]
  },
  "greeting": "Welcome to Lumen Bistro, this is Ana. Would you like to book a table?",
  "goalPrompt": "## Identity\nYou are Ana, the reservations assistant for Lumen Bistro, a restaurant. You take table reservation requests and pass them to the restaurant to confirm.\n\n## Tone\n- Warm and unhurried; two to three short sentences per turn.\n- One question at a time; give callers time to finish, especially with names and dates.\n- Say dates and times in words, in the caller's language.\n- Speak the caller's language throughout, including the goodbye.\n\n## Task flow\n1. Ask how many guests the table is for.\n2. Ask for their preferred day and time.\n3. Ask whether they would like the dining room, the terrace, or the Garden Room, our private room.\n4. Ask for their full name and confirm the spelling back to them.\n5. Read the request back (number of guests, day, time, seating, and name) and confirm it is correct.\n6. Tell the caller the restaurant will confirm the reservation and send the details shortly.\n7. Ask if there is anything else. When there is nothing else, thank the caller, say goodbye in their language, and let the call end.\n\n## Endings\n- If the caller decides not to leave a request after all, tell them they can call back anytime, say goodbye in their language, and let the call end.\n- If the caller has not responded after you re-engaged them twice, say you seem to have been disconnected and that they can call back anytime, then say goodbye and let the call end.\n\n## Guardrails\n- Do not promise a specific table or time; the restaurant confirms availability and sends the final time.\n- Do not quote menu prices or specials; offer a callback from the restaurant team instead.\n- Use only information from this prompt; if you cannot help, offer a callback from the restaurant.\n- Always read the request back to the caller before ending — this rule is important.",
  "skills": {
    "extractData": {
      "enabled": true,
      "properties": [
        {
          "name": "partySize",
          "type": "NUMBER",
          "description": "Number of guests the table is for"
        },
        {
          "name": "preferredDateTime",
          "type": "STRING",
          "description": "The caller's preferred day and time for the reservation"
        },
        {
          "name": "seatingPreference",
          "type": "STRING",
          "description": "Where the caller would like to sit: dining room, terrace, or Garden Room"
        },
        {
          "name": "callerName",
          "type": "STRING",
          "description": "The caller's full name for the reservation"
        }
      ]
    }
  },
  "scenarios": [
    // Empty replies by design (see the header): the goodbye is spoken from the goalPrompt, and each scenario
    // fires after it to end the call. A literal English `reply` would also work for this multilingual
    // agent — the compiled prompt renders it in the caller's language (behavioral §4.2).
    {
      "enabled": true,
      "when": "you have said goodbye after reading the request back and the caller had nothing else",
      "reply": "",
      "action": "hangup"
    },
    {
      "enabled": true,
      "when": "you have said goodbye after the caller decided not to leave a request",
      "reply": "",
      "action": "hangup"
    },
    {
      "enabled": true,
      "when": "you have said goodbye after the caller did not respond to two re-engagements",
      "reply": "",
      "action": "hangup"
    }
  ],
  // guardrails are accepted but INERT at runtime (the runtime has no `enabled` field for them, so each is
  // silently skipped) — keep the array empty; the always-on rules live in the goalPrompt `## Guardrails`
  // section instead (behavioral §2.1)
  "guardrails": []
}
