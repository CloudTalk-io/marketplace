// E6 — Inbound US-English front desk, on the provider the platform's own tree picks: Deepgram.
// Provider: Deepgram ("en-US" is supported exactly by Deepgram but NOT by ElevenLabs, which has no
// regional variants; schema §5 rule 2). Contrast with E4, which chooses Deepgram on a plain "en".
// LLM on Deepgram → Haiku 4.5 (any tier). Both are emitted: a save keeps whatever is stored otherwise.
//
// Fully SELF-CONTAINED and zero-touch: no tools, no SMS, no KB, and no transferToHuman skill at all.
// The front desk answers what it knows and takes the caller's details for a callback, so the prompt never
// promises a handoff it cannot make. `routingDecision` records which team should follow up (useful in the
// call detail and for reporting). To let this line put callers through, ask the user for a real agent or
// ring group id AND extension and add a transfer rule — E1 shows the switched-off shape to ship until
// then, and E3 shows the Call Flow variant for an agent that runs as a step inside a flow.
//
// REQUIRED RESOURCES: nothing to create, but the outbound number is ground truth — set a real owned
//   `defaultOutboundNumberId`, and behind Automatic (1) a real owned `failoverOutboundNumberId` in both
//   directions (only 1 is magic; never guess 2; a bare 1 with no failover 400s).
{
  "agentName": "Cedar Heating & Air: Front Desk (US)",
  "direction": "inbound",
  "defaultOutboundNumberId": 1,    // Automatic — required even for an inbound agent, which never calls out
  "failoverOutboundNumberId": 202, // replace with a real owned number id (cloudtalk_list_numbers or the
                                   // dashboard) — Automatic requires a real failover in BOTH directions
  "language": "en-US",
  "maxCallDuration": 20,
  "temperature": 0.5,
  "voice": "cjVigY5qzO86Huf0OWal", // Eric — American, middle-aged, male
  "optimizeStreamingLatency": 2,
  "stability": 0.3,
  "similarity": 0.7,
  "provider": "deepgram",
  "llm": "anthropic - claude-haiku-4-5",
  "startSpeakingFirst": true,
  "greeting": "Thanks for calling Cedar Heating & Air, this is the front desk. How can I help you today?",
  "goalPrompt": "## Identity\nYou are the front-desk assistant for Cedar Heating & Air, a heating and air-conditioning company in the United States. You answer the main line, give basic information, and take details so the right team can follow up.\n\n## Tone\n- Friendly, clear, and brief: two to three short sentences per turn.\n- Ask one question at a time and wait for the answer.\n- Say numbers as words; read phone numbers and street addresses back in short groups to confirm.\n\n## Business information\n- Hours: Monday to Friday, seven in the morning to seven in the evening; Saturday, eight in the morning to noon.\n- Service area: the city and towns within thirty miles.\n- Estimates are free.\n\n## Task flow\n1. Ask what the caller needs.\n2. For hours, service area, or estimates: answer briefly from the business information above.\n3. For a repair, a maintenance visit, or a free estimate: take the caller's full name, service address, and best callback number, read the address and the number back to confirm them, and tell them the front-desk team will call them back today to book a time.\n4. If the caller smells gas or a carbon monoxide alarm is sounding: tell them to leave the building and call 911 from outside right away, and do not keep them on the line.\n5. Before ending the call, ask if there's anything else.\n\n## Guardrails\n- Use only information in this prompt; if you don't know, say so and offer a callback from the team — never guess.\n- Do not quote prices or troubleshoot equipment over the phone; take the caller's details so the front-desk team can call back.\n- You cannot put callers through to a person on this line; always offer a callback instead.\n- Never share another customer's details or address.\n- For a gas smell or a carbon monoxide alarm, always tell the caller to leave the building and call 911 — this rule is important.",
  "skills": {
    "answerQuestions": {
      "enabled": true,
      "action": "admitUncertainty"
    },
    "extractData": {
      "enabled": true,
      "properties": [
        {
          "name": "routingDecision",
          "type": "STRING",
          "description": "Exactly \"Reception\" if the front-desk team should follow up, otherwise exactly \"Resolved\""
        },
        {
          "name": "callerName",
          "type": "STRING",
          "description": "Caller's full name"
        },
        {
          "name": "callbackNumber",
          "type": "STRING",
          "description": "Best callback number the caller gave, digits only"
        },
        {
          "name": "serviceAddress",
          "type": "STRING",
          "description": "Address where the caller needs the visit, if they gave one"
        },
        {
          "name": "callReason",
          "type": "STRING",
          "description": "One short phrase describing why the caller called"
        }
      ]
    }
  },
  "scenarios": [
    {
      "enabled": true,
      "when": "the caller's question was answered and they have nothing else",
      "reply": "Thanks for calling Cedar Heating & Air. Have a great day!",
      "action": "hangup"
    },
    {
      "enabled": true,
      "when": "the caller has not responded after you re-engaged them twice",
      "reply": "It seems we got disconnected. Please call us back anytime. Goodbye!",
      "action": "hangup"
    }
  ],
  // guardrails are accepted but INERT at runtime (the runtime has no `enabled` field for them, so each is
  // silently skipped) — keep the array empty; the always-on rules live in the goalPrompt `## Guardrails`
  // section instead (behavioral §2.1)
  "guardrails": []
}
