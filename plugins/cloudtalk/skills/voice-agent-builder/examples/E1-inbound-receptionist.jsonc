// E1 — Inbound receptionist (the canonical "default" archetype). Self-contained except for one
// deliberate dashboard step: the switched-off transfer skill (see TRANSFERS below).
// Provider: ElevenLabs (`en` is a plain language; schema §5). LLM: Haiku 4.5. Despite reading like a
// small agent, its goalPrompt runs past 1500 characters, which on its own classifies the agent COMPLEX —
// so the platform's own pick would be Haiku 4.5 too (schema §5). Both are emitted anyway, as every
// example does: they are the agent's stored values, a save keeps whatever the agent (often a blank shell)
// already has when they are omitted, and nothing re-selects them afterwards (behavioral §7b). E3 and E7
// are the examples whose `llm` differs from the platform's pick — their prompts sit below 1500 characters.
//
// Knowledge is folded into the prompt (a screenful of office facts — lower latency than a KB). For a
// larger FAQ, create a knowledge base in the UI and add its ID to `knowledgeBaseIds`.
//
// TRANSFERS — the pattern to copy when you have no real target: `transferToHuman` ships SWITCHED OFF
// (`enabled: false`, `rules: []`). A live transfer needs a real agent or ring group id AND extension from
// the user's account; ask for the pair and this example ships a real rule with `enabled: true` instead
// (that is also when `confirmationRequired` and `includeProperties` start earning their keep — schema §6.1).
// Until then the prompt promises a callback rather than a handoff, so the agent never offers something it
// cannot do, and `routingDecision` still records who should follow up.
{
  "agentName": "Harbor Lane Property Management: Receptionist",
  "direction": "inbound",
  "defaultOutboundNumberId": 1,    // Automatic — required even for an inbound agent, which never calls out
  "failoverOutboundNumberId": 202, // replace with a real owned number id (cloudtalk_list_numbers or the
                                   // dashboard) — Automatic requires a real failover in BOTH directions
  "language": "en",
  "maxCallDuration": 20,
  "temperature": 0.5,
  "voice": "cgSgspJ2msm6clMCkdW9", // Jessica — American, young, female
  "optimizeStreamingLatency": 2,   // never 4 — it disables TTS number/date normalization
  "stability": 0.3,
  "similarity": 0.7,
  "provider": "elevenlabs",
  "llm": "anthropic - claude-haiku-4-5", // also the platform's pick here (prompt > 1500 chars)
  "startSpeakingFirst": true,      // required true for inbound
  "greeting": "Thank you for calling Harbor Lane Property Management, this is Mia. How can I help you today?",
  "goalPrompt": "## Identity\nYou are Mia, the virtual receptionist for Harbor Lane Property Management, which looks after rental apartments for residents and owners. You answer the main phone line, help callers with common questions, and make sure the right team follows up.\n\n## Tone\n- Warm, calm, and professional.\n- Keep responses to 2-3 short sentences unless the caller asks for detail.\n- Ask one question at a time and wait for the answer.\n- Say numbers as words; read phone numbers back in blocks of three or four digits.\n\n## Office information\n- Hours: Monday to Friday, eight in the morning to six in the evening; closed weekends.\n- Services: apartment rentals, viewings, lease renewals, repairs and maintenance, and rent payments.\n- Anyone looking for an apartment is welcome to book a viewing; ask them to bring photo ID.\n- The office confirms every viewing by text message.\n\n## Task flow\n1. Listen to why the caller is calling.\n2. If they ask about services, opening hours, or what to bring: answer using the office information above.\n3. If they want to book, change, or cancel a viewing: take their full name, preferred day and time, and the apartment or area they are interested in, one item at a time, and tell them the office will confirm by text message.\n4. If they report an urgent repair, such as a water leak, no heating, or a door that will not lock: treat it as urgent. Take their full name, address, and best callback number, read the number back to confirm it, and tell them the maintenance team will call them straight back.\n5. For a rent, deposit, or invoice question: take their name and the invoice number and tell them the accounts team will call them back today.\n6. Before ending, ask if there is anything else you can help with.\n\n## Guardrails\n- Use only the information in this prompt; do not infer or add anything else.\n- If you do not know an answer, say so and offer to have the team follow up — never guess.\n- You cannot put callers through to a colleague on this line; always offer a callback instead.\n- Do not promise repair times, rent changes, or lease terms; offer a callback from the right team instead.\n- Never discuss other property management companies or recommend competitors.\n- Use only the information in this prompt — this rule is important.",
  "skills": {
    "transferToHuman": {
      "enabled": false,  // no real target yet — never guess an id/extension: nothing validates them,
                         // so a wrong one fails only mid-call — a cold fallback drops the caller
      "rules": []        // [] is the no-group-in-mind draft shape (legal only while the skill is off).
                         // E9 shows the other shape — a rule with destination "group" and the id/extension
                         // OMITTED. The dashboard shows this skill as "Requires configuration" — pick the
                         // agent/group there and switch it on
    },
    "answerQuestions": {
      "enabled": true,
      "action": "offerAlternative" // answer from the in-prompt facts; steer instead of auto-transferring
    },
    "extractData": {
      "enabled": true,
      "properties": [
        { "name": "callerName", "type": "STRING", "description": "Caller's full name" },
        { "name": "callbackNumber", "type": "STRING", "description": "Best callback number the caller gave, digits only" },
        { "name": "propertyAddress", "type": "STRING", "description": "Address of the apartment with the urgent repair, if the caller reported one" },
        { "name": "routingDecision", "type": "STRING", "description": "Which team should follow up: urgent_maintenance, billing, or general" },
        { "name": "reasonForCall", "type": "STRING", "description": "Brief reason the caller gave for calling" },
        { "name": "preferredDateTime", "type": "STRING", "description": "Preferred day and time for a viewing" },
        { "name": "apartmentOrArea", "type": "STRING", "description": "Apartment or area the caller wants to view" },
        { "name": "invoiceNumber", "type": "STRING", "description": "Invoice number the caller gave for a rent, deposit, or invoice question" }
      ]
    }
  },
  "scenarios": [
    {
      "enabled": true,
      "when": "the caller's request is fully handled and they have nothing else",
      "reply": "Thank you for calling Harbor Lane. Have a lovely day!",
      "action": "hangup"
    },
    {
      "enabled": true,
      "when": "the caller has not responded after you re-engaged them twice",
      "reply": "It seems we got disconnected. Please call us back anytime. Goodbye!",
      "action": "hangup"
    }
  ],
  // guardrails are accepted but INERT at runtime (the runtime has no `enabled` field for them, so each is
  // silently skipped) — keep the array empty; the always-on safety rules live in the goalPrompt
  // `## Guardrails` section instead (behavioral §2.1)
  "guardrails": []
}
